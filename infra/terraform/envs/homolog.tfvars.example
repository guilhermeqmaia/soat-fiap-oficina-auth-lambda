environment = "homolog"
aws_region  = "us-east-1"
project     = "oficina"

# --- IAM ---------------------------------------------------------------------
# Conta propria: deixe vazio (o Terraform cria a role de execucao) e informe o
# repositorio para gerar a role OIDC do GitHub Actions.
# AWS Academy/Learner Lab: use a LabRole e deixe github_repository vazio
# (nesse caso o deploy usa AWS_ACCESS_KEY_ID/SECRET/SESSION_TOKEN).
lambda_role_arn   = ""
github_repository = "engineercodeprojects/software-architecture-tech-challenge-lambda"
# create_github_oidc_provider = true  # apenas se a conta ainda nao tem o provider

# --- Segredos ----------------------------------------------------------------
# Preferido: aponte para secrets que ja existem (criados pelo repo do banco).
jwt_secret_id = ""
db_secret_id  = ""
# Alternativa: o Terraform cria os secrets com estes valores.
# Passe via -var (nao versione segredo em arquivo):
#   terraform apply -var="jwt_secret_value=..." -var="database_url=..."
# jwt_secret_value = ""
# database_url     = ""

# --- Aplicacao ---------------------------------------------------------------
jwt_issuer     = "oficina-auth-lambda"
jwt_expires_in = "1h"
log_level      = "debug"

cliente_table      = "cliente"
cliente_cpf_column = "cpf_cnpj"
# O schema da Fase 2 ainda nao tem coluna de status; ao criar (ex.: `ativo`),
# preencha abaixo para habilitar a resposta 403 de cliente inativo.
cliente_status_column = ""

# --- Rede (obrigatorio se o RDS estiver em subnets privadas) -----------------
subnet_ids         = []
security_group_ids = []
