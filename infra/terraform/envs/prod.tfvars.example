environment = "prod"
aws_region  = "us-east-1"
project     = "oficina"

# Academy: sempre a LabRole (o lab nao permite criar IAM roles)
lambda_role_arn   = "arn:aws:iam::123456789012:role/LabRole"
# Vazio no Academy (nada de IAM); em conta propria use o SEU repo, ex.:
# github_repository = "guilhermeqmaia/soat-fiap-oficina-auth-lambda"
github_repository = ""

jwt_secret_id = ""
db_secret_id  = ""

jwt_issuer     = "oficina-auth-lambda"
jwt_expires_in = "15m"
log_level      = "info"

cliente_table         = "cliente"
cliente_cpf_column    = "cpf_cnpj"
cliente_status_column = ""

subnet_ids         = []
security_group_ids = []
