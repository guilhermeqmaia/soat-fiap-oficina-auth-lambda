# ─────────────────────────────────────────────────────────────────────────────
# Configuracao da function de autenticacao por CPF.
#
# Copie para `.env` (`cp .env.example .env`) para rodar/testar localmente.
# Na AWS, estas variaveis vao no `environment` da Lambda (ver infra/terraform),
# e os valores sensiveis ficam no AWS Secrets Manager (JWT_SECRET_ID/DB_SECRET_ID).
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT ──────────────────────────────────────────────────────────────────────
# Local: segredo em texto. Precisa ser IGUAL ao JWT_SECRET da aplicacao
# (monolito NestJS), que valida o token como resource server.
#
# ATENCAO: use um segredo de DESENVOLVIMENTO aqui — nunca o de producao. Este
# valor fica em texto puro no seu disco; em producao o unico caminho e o AWS
# Secrets Manager (JWT_SECRET_ID), que tem precedencia sobre esta variavel.
# Para gerar um: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-forte-de-32-chars

# Producao: nome/ARN do secret no Secrets Manager (tem precedencia sobre JWT_SECRET).
# JWT_SECRET_ID=oficina-mecanica/jwt
# Chave a extrair quando o secret guarda um JSON (default: JWT_SECRET).
# JWT_SECRET_JSON_KEY=JWT_SECRET

JWT_ISSUER=oficina-auth-lambda
JWT_EXPIRES_IN=1h
# JWT_AUDIENCE=oficina-mecanica-api

# ── Banco de dados ───────────────────────────────────────────────────────────
# Local (docker compose deste repo):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oficina_mecanica?schema=public
# Producao: secret com a connection string ou com o formato do RDS
# ({username,password,host,port,dbname}). Tem precedencia sobre DATABASE_URL.
# DB_SECRET_ID=oficina-mecanica/db

# SSL obrigatorio no RDS; desligue apenas para o Postgres local.
DB_SSL=false
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000

# ── Mapeamento da tabela de clientes (schema da Fase 2) ──────────────────────
CLIENTE_TABLE=cliente
CLIENTE_CPF_COLUMN=cpf_cnpj
CLIENTE_ID_COLUMN=id
CLIENTE_NOME_COLUMN=nome
# Coluna de status/atividade do cliente. Vazio => todo cliente encontrado e
# considerado ativo (o schema atual da Fase 2 nao tem a coluna). Ao criar a
# coluna na aplicacao (ex.: `ativo boolean`), preencha aqui para habilitar o 403.
# CLIENTE_STATUS_COLUMN=ativo
CLIENTE_STATUS_ATIVO_VALUES=true,t,1,ativo,active

# ── Token e logs ─────────────────────────────────────────────────────────────
CLIENTE_ROLE=CLIENTE
LOG_LEVEL=info
