{
  "name": "software-architecture-tech-challenge-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Function serverless de autenticacao por CPF (emissor de JWT) da oficina mecanica",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "BUILD_DEV=1 node scripts/build.mjs",
    "invoke:local": "npm run build:dev && node scripts/local-invoke.mjs",
    "package": "npm run build && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check \"**/*.{ts,js,mjs,json,md,yml}\"",
    "format:write": "prettier --write \"**/*.{ts,js,mjs,json,md,yml}\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "docker:build": "docker build -t oficina-auth-lambda:local .",
    "docker:run": "docker run --rm -p 9000:8080 --env-file .env oficina-auth-lambda:local"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.716.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
